# The built WASM (web/merlin.wasm) and web/wasm_exec.js ARE committed —
# same convention as carledwards/6502-sim-tui — so the repo is browsable
# and GitHub Pages works even without a CI run. The wasm-pages workflow
# rebuilds them fresh on deploy regardless.

# OS / editor noise
.DS_Store
*.swp

# Claude
.claude/

# Locally-built native binaries. The repo only commits the wasm output
# (see top comment); `make mcp` and friends produce host-arch binaries
# here that no other developer or CI step should pick up.
/bin/
